# Optional pin for the ZettaLane CSI driver image. Without this file installs take the
# published `latest`, which is verified as a pair with the matching zettabranch release.
# Pin here when a specific driver is required -- e.g. against an older storage image,
# since the bundled mayacli must match configd's XDR and a mismatch fails SILENTLY
# (decode error -> ENOENT -> [] -> quiet fallback).
CSI_IMAGE_VERSION=1.0.8
CSI_IMAGE_REGISTRY=ghcr.io/zettalane-systems
