# Single source of truth for the ZettaLane CSI driver image.
#
# The image bundles mayacli, whose XDR must match the storage node's configd --
# rpcgen changes have NO backward compatibility, and a mismatch fails SILENTLY
# (show mapping returns "Can't decode result" -> ENOENT -> [] -> quiet fallback).
# So this is pinned, never `latest`, and moves in lockstep with the storage image.
#
# Every install path reads THIS file. Four independent copies drifted before:
# k3s and aks were bumped to 1.0.6 while eks sat on 1.0.1 and gke on 1.0.0 --
# and eks could not mount a volume at all on AL2023 because of it.
CSI_IMAGE_VERSION=1.0.7
CSI_IMAGE_REGISTRY=ghcr.io/zettalane-systems
